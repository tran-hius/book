PORT=3000
NODE_ENV=development

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=your_mysql_password
DB_NAME=bookstore
MYSQL_ROOT_PASSWORD=your_root_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TTL=300
REDIS_KEY_PREFIX=bookstore:
